<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#052B2B"
    tools:context=".MainActivity">

    <!-- Background Asli -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- CONTAINER UTAMA (CARD) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="80dp"
        app:cardBackgroundColor="#00FFFFFF"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:strokeColor="#F9B637"
        app:strokeWidth="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Logo Custom -->
            <ImageView
                android:id="@+id/ivLogoCustom"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginBottom="8dp"
                android:contentDescription="Logo Aplikasi"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_app" />

            <!-- Judul ET-Pemilos -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="E-Pemilos"
                android:textColor="#F9B637"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Garis Emas Tipis -->
            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginBottom="20dp"
                android:background="#F9B637" />

            <!-- INPUT NAMA (GOLD & TIPIS) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:boxBackgroundColor="#00000000"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="#F9B637"
                app:boxStrokeWidth="1dp"
                app:hintTextColor="#F9B637">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNama"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/full_name"
                    android:minHeight="45dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#88FFFFFF"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- INPUT STATUS (GOLD & TIPIS) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:boxBackgroundColor="#00000000"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="#F9B637"
                app:boxStrokeWidth="1dp"
                app:hintTextColor="#F9B637"
                app:startIconDrawable="@android:drawable/ic_menu_compass"
                app:startIconTint="#F9B637">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/student_status"
                    android:minHeight="45dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#88FFFFFF"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- INPUT TOKEN (GOLD & TIPIS) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:boxBackgroundColor="#00000000"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxStrokeColor="#F9B637"
                app:boxStrokeWidth="1dp"
                app:hintTextColor="#F9B637"
                app:startIconDrawable="@android:drawable/ic_lock_lock"
                app:startIconTint="#F9B637">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/voter_token"
                    android:inputType="textPassword"
                    android:minHeight="45dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#88FFFFFF"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- ROW TOMBOL (RAPI) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Tombol Masuk -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMasuk"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="@string/btn_login_vote"
                    android:textAllCaps="false"
                    android:textColor="#052B2B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#F9B637"
                    app:cornerRadius="21dp"
                    app:elevation="2dp" />

                <!-- Icon Kotak Suara -->
                <ImageView
                    android:id="@+id/imgKotakSuara"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="14dp"
                    android:background="@drawable/gold_circle_bg"
                    android:clickable="true"
                    android:contentDescription="Admin"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@android:drawable/ic_menu_agenda" />
            </LinearLayout>
        </LinearLayout> <!-- TUTUP LINEAR LAYOUT -->
    </com.google.android.material.card.MaterialCardView> <!-- TUTUP CARD VIEW -->
</androidx.constraintlayout.widget.ConstraintLayout> <!-- TUTUP CONSTRAINT LAYOUT -->