<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.e_pemilos">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EPEMILOS">

        <!-- Activity Utama (Login Siswa / Entry Point) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity Alur Voting Siswa -->
        <activity
            android:name=".KandidatActivity"
            android:exported="false" />

        <activity
            android:name=".DetailKandidatActivity"
            android:exported="false" />

        <activity
            android:name=".SuccessActivity"
            android:exported="false" />

        <!-- Activity Alur Management Admin -->
        <activity
            android:name=".AdminMainActivity"
            android:exported="false" />

        <activity
            android:name=".admin"
            android:exported="false" />

        <activity
            android:name=".admin_kandidat"
            android:exported="false" />

        <activity
            android:name=".admin_peserta"
            android:exported="false" />

        <activity
            android:name=".HasilActivity"
            android:exported="false" />

    </application>

</manifest>